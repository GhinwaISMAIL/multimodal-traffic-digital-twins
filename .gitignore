# ══════════════════════════════════════════════════════════════════════════════
#  .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# ── Testbed config — contains real SSH hostnames and UE IPs ───────────────────
# Never commit this. Use testbed_config.example.yaml as the template.
testbed_config.yaml

# ── Generated run artifacts ───────────────────────────────────────────────────
# traffic_profiles/ can be large and is fully reproducible from the notebooks.
# Commit scenario_config.yaml instead to reproduce any specific run.
traffic_profiles/

# ── Projected burst files (Notebook 0 output) ────────────────────────────────
# These are derived from the Markov files and can be regenerated by
# running Notebook 0. The raw Markov files (synth_test_bursts_markov.parquet)
# are committed as part of artifacts/.
**/synth_test_bursts_mgen.parquet

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
*.egg

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/
artifacts/
data/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# local safety copies and machine-specific config
*.bak
*_back_up.ipynb
testbed_config.yaml
traffic_profiles/
